# ---------- Required ----------
# Railway: reference the Postgres service →  DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/sumt
# Generate all four with:  npm run build && npm run keys:generate
LICENSE_SIGNING_PRIVATE_KEY=
ACTIVATION_KEY_PEPPER=
JWT_ACCESS_SECRET=
DOWNLOAD_TICKET_SECRET=

# ---------- Recommended on Railway ----------
NODE_ENV=production
# Mount a Railway Volume at /data
STORAGE_DIR=/data/resources
# Your public URL, e.g. https://sumt-backend-production.up.railway.app (no trailing slash)
PUBLIC_BASE_URL=

# ---------- First admin (remove both after first successful deploy) ----------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- Optional tuning (defaults shown) ----------
# PORT=3000                     # Railway injects PORT automatically
# LOG_LEVEL=info
# ACCESS_TOKEN_TTL_MIN=15
# REFRESH_TOKEN_TTL_DAYS=30
# OFFLINE_GRACE_HOURS=72
# REQUEST_CLOCK_SKEW_SEC=300
# ACTIVATION_MAX_FAILURES=10
# ACTIVATION_LOCK_MINUTES=30
# ADMIN_MAX_FAILED_LOGINS=5
# ADMIN_LOCK_MINUTES=15
# DEFAULT_KEY_VALID_HOURS=72
# RATE_LIMIT_GLOBAL_PER_MIN=300
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_REGISTER_PER_MIN=20
# MAX_UPLOAD_MB=512
# DOWNLOAD_TICKET_TTL_SEC=600
# ENFORCE_HTTPS=true
# CORS_ORIGINS=                  # only if a web admin dashboard is added later

# ---------- Optional: Google Play Integrity ----------
# INTEGRITY_MODE=off             # off | log | enforce
# ANDROID_PACKAGE_NAME=com.sumt.terminal
# PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
